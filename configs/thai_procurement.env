# Thai Procurement LegalGraphRAG Configuration
# Ingests typhoon_ocr statutes and CGD FAQ corpus with OpenRouter LLM backend

model_name=openrouter
OPENROUTER_API_KEY=
LLM_MODEL=qwen/qwen3.5-9b
device=cpu
prompt_language=th

# OpenRouter Configuration
base_url=https://openrouter.ai/api/v1
max_length=4096
temperature=0.0

# Thai Procurement Corpus Paths
case_db_path=./datas/thai_corpus/cases_with_feature.json
law_to_crime_path=./datas/thai_corpus/law_to_crime.json
datasets_path=./datasets
output_dir=./outputs/thai_procurement

# Multi-Agent Retrieval Configuration
top_retrieve=True
direct_retrieve=True
augment_retrieve=False
top_retrieve_top_k=3
direct_retrieve_top_k=3

# Graph Database
graph_db_path=./outputs/thai_procurement/openrouter_graph_db.pkl
embedding_api_url=http://localhost:11434/api/embed
embedding_model=VISAI-AI/nitibench-ccl-human-finetuned-bge-m3
auto_save=True
auto_build=True
