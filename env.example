# ==============================================================================
# 1. LLM Generation Layer (OpenRouter API)
# ==============================================================================
model_name="openrouter"
OPENROUTER_API_KEY=""
LLM_MODEL="qwen/qwen3.5-9b"
base_url="https://openrouter.ai/api/v1"
device="cpu"
prompt_language="th"
temperature=0.0
max_length=4096

# ==============================================================================
# 2. Embedding Layer (Tokenmind BGE-M3 API)
# ==============================================================================
embedding_provider="tokenmind"
TOKENMIND_API_KEY=""
TOKENMIND_BASE_URL="https://tokenmind.abdul.in.th/v1"
TOKENMIND_EMBEDDING_MODEL="BAAI/bge-m3"

# ==============================================================================
# 3. API-First Reranker (Opper AI Gateway)
# ==============================================================================
enable_reranker=true
reranker_provider="opper"
OPPER_API_KEY=""
OPPER_RERANKER_MODEL="berget/bge-reranker-v2-m3"
OPPER_RERANK_URL="https://api.opper.ai/v3/rerank"
reranker_threshold=0.20

# ==============================================================================
# 4. Corrective RAG: Jev 1.13 Retrieval Evaluator
# ==============================================================================
USE_JEV_FILTER=true
JEV_FILTER_THRESHOLD=0.45
JEV_MODEL="typesafe/jev-1.13"

# ==============================================================================
# 5. Core Paths & Retrieval Budgets
# ==============================================================================
law_to_crime_path="./datas/law_to_crime.json"
case_db_path="./datas/cases_with_feature.json"
graph_db_path="./outputs/openrouter_graph_db.pkl"
datasets_path="./datasets"
output_dir="./outputs"
direct_retrieve=true
direct_retrieve_top_k=8
bm25_top_k=30
dense_top_k=30
auto_save=true
auto_build=true

# ==============================================================================
# 6. Production Tri-Store Database (PostgreSQL + Qdrant + Neo4j)
#    Enable by setting USE_TRI_STORE=true when running with docker-compose
# ==============================================================================
USE_TRI_STORE=false
USE_AGENTIC_RAG=false
DEFAULT_ORG_ID="DGA"
ENABLE_TENANT_ISOLATION=true

# PostgreSQL (RDBMS / Single Source of Truth)
POSTGRES_HOST="localhost"
POSTGRES_PORT=5435
POSTGRES_DB="procurement_rag"
POSTGRES_USER="procurement_user"
POSTGRES_PASSWORD="procurement_secret123"

# Qdrant (Dense Vector Database)
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=""
QDRANT_DENSE_DIM=1024

# Neo4j (Graph Database & Legal Topology)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="procurement_secret123"
