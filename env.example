# Copy this file to configs/thai_procurement.env or .env and fill in your keys:
# cp env.example configs/thai_procurement.env

# ====================================
# Model & LLM Configuration
# ====================================
model_name="openrouter"
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_MODEL="qwen/qwen3.5-9b"
device="cpu"
prompt_language="th"

# OpenRouter / OpenAI compatible endpoint
base_url="https://openrouter.ai/api/v1"
max_length="4096"
temperature="0.0"

# =====================================
# Thai Procurement Corpus Paths
# =====================================
case_db_path="./datas/cases_with_feature.json"
law_to_crime_path="./datas/law_to_crime.json"
datasets_path="./datasets"
output_dir="./outputs"

# ======================================
# Multi-Agent Retrieval Configuration
# ======================================
top_retrieve=False
direct_retrieve=True
augment_retrieve=False
top_retrieve_top_k=3
direct_retrieve_top_k=8

# ======================================
# Graph Database Configuration
# ======================================
graph_db_path="./outputs/openrouter_graph_db.pkl"
embedding_api_url="http://localhost:11434/api/embed"
embedding_model="unsloth/embeddinggemma-300m"
auto_save=True
auto_build=True

# ===============================================
# Hybrid Retrieval & GPU Reranker Configuration
# ===============================================
hybrid_retrieval=True
bm25_top_k=30
dense_top_k=30
reranker_model="BAAI/bge-reranker-v2-m3"
reranker_device=cuda:0
reranker_threshold=0.20
rrf_k=60
