# ==============================================================================
# 1. LLM Generation Layer (OpenRouter API)
# ==============================================================================
MODEL_NAME="openrouter"
OPENROUTER_API_KEY=""
LLM_MODEL="qwen/qwen3.5-9b"
LLM_BASE_URL="https://openrouter.ai/api/v1"
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
PROMPT_LANGUAGE="th"

# ==============================================================================
# 2. Embedding Layer (Tokenmind BGE-M3 API)
# ==============================================================================
EMBEDDING_PROVIDER="tokenmind"
TOKENMIND_API_KEY=""
TOKENMIND_BASE_URL="https://tokenmind.abdul.in.th/v1"
TOKENMIND_EMBEDDING_MODEL="BAAI/bge-m3"

# ==============================================================================
# 3. Reranker Layer (Local Cross-Encoder BGE-Reranker-v2-m3 / Opper AI)
# ==============================================================================
RERANKER_ENABLED=true
RERANKER_PROVIDER="local"
RERANKER_THRESHOLD=0.20
RERANK_POOL_SIZE=40

# (Optional: Only if reranker_provider is set to "opper")
OPPER_API_KEY=""
OPPER_RERANKER_MODEL="berget/bge-reranker-v2-m3"
OPPER_RERANK_URL="https://api.opper.ai/v3/rerank"

# ==============================================================================
# 4. Agentic RAG & Pipeline Configuration
# ==============================================================================
RAG_MODE="agentic"
AGENTIC_MAX_RETRIES=2

# Static Knowledge Base & Graph Cache Paths
LAW_TO_CRIME_PATH="./datas/law_to_crime.json"
CASE_DB_PATH="./datas/cases_with_feature.json"
GRAPH_DB_PATH="./outputs/graph_db.pkl"
DATASETS_PATH="./datasets"
OUTPUT_DIR="./outputs"

# Retrieval parameters
DIRECT_RETRIEVE=true
DIRECT_RETRIEVE_TOP_K=10
bm25_top_k=30
DENSE_TOP_K=30
AUTO_SAVE=false
AUTO_BUILD=false

# ==============================================================================
# 5. Production Tri-Store Database (PostgreSQL + Qdrant + Neo4j)
#    Enable by setting USE_TRI_STORE=true (docker compose sets it automatically)
# ==============================================================================
USE_TRI_STORE=false
DEFAULT_ORG_ID="DGA"

# General ceiling (THB) for the specific method; /verify and the guardrail both read it.
# Pending legal confirmation - see core/compliance_constants.py
SPECIFIC_METHOD_CEILING_THB=500000

# Database passwords below are local-development placeholders: change them before deploying anywhere reachable.
# PostgreSQL (RDBMS / Single Source of Truth)
POSTGRES_HOST="localhost"
POSTGRES_PORT=5435
POSTGRES_DB="procurement_rag"
POSTGRES_USER="procurement_user"
POSTGRES_PASSWORD="procurement_secret123"
# Runtime role subject to Row-Level Security (not superuser, not table owner).
# Leave the password empty to disable RLS enforcement (tenant queries then run as POSTGRES_USER).
POSTGRES_APP_USER="procurement_app"
POSTGRES_APP_PASSWORD="change_me_app_secret"

# Qdrant (Dense Vector Database)
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=""
QDRANT_DENSE_DIM=1024

# Neo4j (Graph Database & Legal Topology)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="procurement_secret123"

# ==============================================================================
# 6. Serving Limits & Hardening
# ==============================================================================
# Concurrent agentic QA runs (REST + MCP share the pool); extra callers wait up to
# QA_QUEUE_TIMEOUT_SECONDS, then get HTTP 503 (MCP status "BUSY")
QA_MAX_CONCURRENCY=4
QA_QUEUE_TIMEOUT_SECONDS=30
# Per-request LLM timeout (seconds); keeps one stalled call from exceeding the 5-min /qa budget
LLM_TIMEOUT_SECONDS=60
# In-memory query-embedding LRU size
EMBEDDING_CACHE_SIZE=5000
# Agent trace log (outputs/THAI/agentic_traces.jsonl) rotation
TRACE_LOG_MAX_MB=50
TRACE_LOG_BACKUPS=5
# Comma-separated browser origins allowed by CORS (empty = any origin, without credentials)
CORS_ALLOW_ORIGINS=""
# Comma-separated Host headers accepted by the MCP endpoint (empty = no DNS-rebinding check)
MCP_ALLOWED_HOSTS=""
